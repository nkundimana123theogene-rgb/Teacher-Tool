rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection Matcher
    match /users/{email} {
      allow read, write: if true;
    }

    // Payments Collection Matcher
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Plan Logs Collection Matcher
    match /planLogs/{logId} {
      allow read, write: if true;
    }

    // Reset Codes Collection Matcher
    match /resetCodes/{email} {
      allow read, write: if true;
    }
  }
}
