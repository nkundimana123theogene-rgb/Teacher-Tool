rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // URGENT NOTICE: 
    // Firebase Auth (Email/Password & Anonymous) is currently DISABLED in your Firebase Console.
    // This causes request.auth to be null, crashing all security rules and failing all syncing.
    // As a temporary emergency fix to make your app work, ALL rules have been set to true.
    //
    // FIX: Go to Firebase Console -> Authentication -> Sign-in Method 
    // and enable "Email/Password" and "Anonymous" auth. Then you can revert these rules.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
