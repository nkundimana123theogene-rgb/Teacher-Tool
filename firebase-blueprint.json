{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile registered in Teacher Tool.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "currentPlan": { "type": "string" },
        "remainingPlans": { "type": "number" },
        "totalGenerated": { "type": "number" },
        "lastFreeResetMonth": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "authProvider": { "type": "string" },
        "password": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "status": { "type": "string" },
        "loginCount": { "type": "number" },
        "sessionToken": { "type": "string" }
      },
      "required": ["id", "email", "name", "country", "currentPlan", "remainingPlans", "totalGenerated", "isAdmin"]
    },
    "PaymentSubmission": {
      "title": "PaymentSubmission",
      "description": "A proof of payment submitted by a user for plan activation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "planId": { "type": "string" },
        "planLabel": { "type": "string" },
        "amountFrw": { "type": "number" },
        "plansCount": { "type": "number" },
        "momoTxRef": { "type": "string" },
        "momoNumber": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userEmail", "planId", "momoTxRef", "status", "timestamp"]
    },
    "PlanLog": {
      "title": "PlanLog",
      "description": "A log of a generated lesson plan for administrative auditing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string" },
        "classGrade": { "type": "string" },
        "unitTitle": { "type": "string" },
        "lessonTitle": { "type": "string" },
        "language": { "type": "string" },
        "format": { "type": "string" },
        "timestamp": { "type": "string" },
        "schoolName": { "type": "string" },
        "instructionalObjective": { "type": "string" }
      },
      "required": ["id", "userEmail", "subject", "lessonTitle", "timestamp"]
    },
    "ResetCode": {
      "title": "ResetCode",
      "description": "A temporary verification code for user password recovery.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "code": { "type": "string" },
        "expiresAt": { "type": "number" }
      },
      "required": ["email", "code", "expiresAt"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "An official certificate generated and verified in Nkorera Education.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "certificateNumber": { "type": "string" },
        "userEmail": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientRole": { "type": "string" },
        "schoolName": { "type": "string" },
        "certificateTitle": { "type": "string" },
        "category": { "type": "string" },
        "citationText": { "type": "string" },
        "issueDate": { "type": "string" },
        "issuer1Name": { "type": "string" },
        "issuer1Title": { "type": "string" },
        "issuer2Name": { "type": "string" },
        "issuer2Title": { "type": "string" },
        "borderStyle": { "type": "string" },
        "language": { "type": "string" },
        "gender": { "type": "string" },
        "courseName": { "type": "string" },
        "schoolLogo": { "type": "string" },
        "issuer1Signature": { "type": "string" },
        "issuer2Signature": { "type": "string" },
        "useCursiveSignatures": { "type": "boolean" }
      },
      "required": ["id", "createdAt", "certificateNumber", "recipientName", "schoolName", "certificateTitle", "category", "citationText", "issueDate", "issuer1Name", "issuer1Title", "borderStyle", "language"]
    },
    "ClassDiary": {
      "title": "ClassDiary",
      "description": "A class diary (cahier de textes) record generated by a teacher.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "classGrade": { "type": "string" },
        "date": { "type": "string" },
        "period": { "type": "string" },
        "lessonTitle": { "type": "string" },
        "workCoveredSummary": { "type": "string" },
        "skillsCompetencesTargeted": { "type": "string" },
        "homeworkAssigned": { "type": "string" },
        "attendanceNotes": { "type": "string" },
        "remarksObservations": { "type": "string" },
        "language": { "type": "string" }
      },
      "required": ["id", "createdAt", "userEmail", "subject", "classGrade", "date", "period", "lessonTitle", "workCoveredSummary", "skillsCompetencesTargeted", "language"]
    },
    "Tutorial": {
      "title": "Tutorial",
      "description": "System video tutorial and module guide item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "module": { "type": "string" },
        "description": { "type": "string" },
        "videoUrl": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "version": { "type": "string" },
        "videoScript": { "type": "string" },
        "guideContent": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "module", "description"]
    }
  },
  "firestore": {
    "users/{email}": {
      "schema": "User",
      "description": "User profiles indexed by their lowercase email."
    },
    "payments/{paymentId}": {
      "schema": "PaymentSubmission",
      "description": "Payment proof submissions."
    },
    "planLogs/{logId}": {
      "schema": "PlanLog",
      "description": "Logs of generated lesson plans."
    },
    "resetCodes/{email}": {
      "schema": "ResetCode",
      "description": "Verification codes for forgot password."
    },
    "certificates/{certificateId}": {
      "schema": "Certificate",
      "description": "Official certificates indexed by their ID or Certificate Number."
    },
    "classDiaries/{diaryId}": {
      "schema": "ClassDiary",
      "description": "Class diary records for lesson monitoring."
    },
    "tutorials/{tutorialId}": {
      "schema": "Tutorial",
      "description": "System video tutorials and module documentation guides."
    }
  }
}
